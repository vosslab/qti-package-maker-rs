{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "skipLibCheck": false
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "tests/**/*.ts", "playwright.config.ts"],
  "exclude": ["examples/browser/worker.ts"]
}
