{
	"name": "@vosslab/qpm-wasm",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "LGPL-3.0-or-later",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		},
		"./qpm_wasm_bg.wasm": "./dist/generated/qpm_wasm_bg.wasm"
	},
	"files": [
		"dist/src",
		"dist/generated",
		"dist/LICENSE.LGPL-3.0"
	],
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
		"test": "node --test tests/host.test.mjs",
		"test:browser": "playwright test",
		"measure": "node scripts/measure.mjs",
		"example:node": "node dist/examples/node.js",
		"example:browser": "node scripts/serve.mjs"
	},
	"devDependencies": {
		"@playwright/test": ">=1.64.1",
		"@types/node": ">=26.6.6",
		"fflate": ">=0.8.3",
		"typescript": ">=7.0.2",
		"wasm-pack": ">=0.15.0"
	},
	"allowScripts": {
		"wasm-pack@0.15.0": true
	}
}
